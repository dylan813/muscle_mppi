<mujoco model="go2 scene">
  <include file="go2.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.45 0.45 0.45" rgb2="0.3 0.3 0.3" markrgb="0.7 0.7 0.7" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <!-- Distinct color for the platforms so they stand out against the gray floor. -->
    <!-- <material name="platform" rgba="0.85 0.45 0.15 1" reflectance="0.1" /> -->
    <material name="platform" rgba="0.20 0.62 0.32 1" reflectance="0.1" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    <!-- Two flat platforms of equal height (top z=0.06) with a 0.25m gap
         between them (x in [0.8, 1.05]). The robot spawns on platform A at
         world x=0 and must cross the gap to land on platform B at the same
         elevation. mppi_sim's spawn placement needs
         task.spawn_height_offset=0.06 (see tasks.yaml) to land the robot on
         top of platform A instead of at z=0. -->
    <geom name="guinea_fowl_platform_a" type="box" pos="0.15 0.0 0.04" size="0.65 0.5 0.04" material="platform" />
    <geom name="guinea_fowl_platform_b" type="box" pos="2.0 0.0 0.04" size="0.65 0.5 0.04" material="platform" />
  </worldbody>
</mujoco>
